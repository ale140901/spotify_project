# Database Configuration Template
# Copy this file to .Renviron and fill in your actual values
# DO NOT commit .Renviron to version control

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spotify_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Optional: Looker Settings (if using Looker)
LOOKER_HOST=your_looker_instance.com
LOOKER_CLIENT_ID=your_client_id
LOOKER_CLIENT_SECRET=your_client_secret

# Optional: Spotify API (if fetching data from Spotify)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
